{
  "family": "aws-advance-arch-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/aws-advance-arch-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/aws-advance-arch-backend-task-role",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/aws-advance-arch-backend:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 3000, "protocol": "tcp", "appProtocol": "http" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -fsS http://127.0.0.1:3000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "environment": [
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "PORT", "value": "3000" },
        { "name": "COGNITO_USER_POOL_ID", "value": "<USER_POOL_ID>" },
        { "name": "COGNITO_CLIENT_ID", "value": "<APP_CLIENT_ID>" },
        { "name": "ALLOWED_ORIGINS", "value": "https://<ADMIN_AMPLIFY_DOMAIN>,https://<UI_AMPLIFY_DOMAIN>" },
        { "name": "APP_SECRET_ID", "value": "slotta-dummy/app" },
        { "name": "DYNAMODB_TABLE_NAME", "value": "aws-advance-arch-items" },
        { "name": "LOGO_BUCKET", "value": "<LOGO_BUCKET_NAME>" },
        { "name": "WAITLIST_EVENTS_QUEUE_URL", "value": "https://sqs.us-east-1.amazonaws.com/<AWS_ACCOUNT_ID>/waitlist-events" },
        { "name": "CALENDAR_TOKENS_KMS_KEY_ID", "value": "<KMS_KEY_ARN>" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/aws-advance-arch-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
